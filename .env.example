# BipolarBird keys and settings — ONE file for the whole project.
# Copy to .env (git-ignored) and paste your keys. The API and the sidecar both read it.

# ── Database ─────────────────────────────────────────────────────────────
# Local docker (default):
DATABASE_URL=postgresql://moodbeacon:moodbeacon@localhost:5433/moodbeacon
# Tiger Data: paste your service's connection string instead, e.g.
# DATABASE_URL=postgresql://tsdbadmin:<password>@<host>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require

# ── Gemini (optional: plain-language weekly summary) ─────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ── Presage SmartSpectra (camera readings) ───────────────────────────────
PRESAGE_API_KEY=
# "mock" = fake readings for UI work, "presage" = real camera via SmartSpectra
SOURCE=mock
# Command that runs the SmartSpectra SDK bridge (relative to sidecar/). Key is passed via env.
PRESAGE_CMD="node presage_node/stream.mjs"

# ── Internal (no need to change) ─────────────────────────────────────────
# Shared secret between API and sidecar
SIDECAR_TOKEN=change-me
API_WS_URL=ws://localhost:8000/ws/sidecar
CORS_ORIGINS=http://localhost:5173
